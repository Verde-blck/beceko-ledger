{
  "name": "beceko-ledger",
  "version": "1.5.1",
  "private": true,
  "description": "Customer and money ledger for Beceko",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "check-ai": "node --env-file-if-exists=.env scripts/check-ai.js",
    "check-gemini": "npm run check-ai"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.0.0",
    "express": "^5.3.0",
    "pdfkit": "^0.20.2"
  }
}
