# 4 to 8 digits, used to open the ledger
LEDGER_PIN=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

BUSINESS_NAME=Beceko
# Optional line printed at the bottom of every statement, such as bank details
STATEMENT_NOTE=
# Thank-you line at the end of every statement
STATEMENT_CLOSING=Thank you for your patronage.
LEDGER_TIME_ZONE=Africa/Lagos

# Optional. Enables typed and spoken quick entry. Set one key.
# Claude is used if its key is set; AI_PROVIDER=gemini forces Gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_PROVIDER=

PORT=3000
DATABASE_FILE=data/ledger.db

# Clears every customer and entry once, then does nothing. See the README before using it.
# RESET_LEDGER=fresh-start-1

# Set both to true when running behind HTTPS on a hosted server
COOKIE_SECURE=false
TRUST_PROXY=false
