# 4 to 8 digits, used to open the ledger
LEDGER_PIN=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

BUSINESS_NAME=Beceko
LEDGER_TIME_ZONE=Africa/Lagos

# Optional. Enables typed and spoken quick entry.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

PORT=3000
DATABASE_FILE=data/ledger.db

# Clears every customer and entry once, then does nothing. See the README before using it.
# RESET_LEDGER=fresh-start-1

# Set both to true when running behind HTTPS on a hosted server
COOKIE_SECURE=false
TRUST_PROXY=false
